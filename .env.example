# Environment Configuration
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and should never be committed.

# ── Google Gemini AI ──────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_API_MODEL=gemini-3.5-flash-lite

# ── Database (only needed when running without Docker Compose) ─
# When using `docker compose up`, these are set automatically.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/advisor
# SPRING_DATASOURCE_USERNAME=advisor
# SPRING_DATASOURCE_PASSWORD=advisor